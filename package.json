{
  "name": "animate-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-preserve-output server/index.mjs",
    "start": "node server/index.mjs",
    "build": "tsc -b && vite build --mode node",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.cloudflare.json",
    "test": "node --test tests/*.test.mjs",
    "dev:cloudflare": "vite --mode cloudflare --host 127.0.0.1 --port 4174",
    "build:cloudflare": "void prepare && npm run typecheck && vite build",
    "preview:cloudflare": "vite preview --mode cloudflare --host 127.0.0.1 --port 4174",
    "deploy:cloudflare": "void prepare && npm run typecheck && void deploy --platform cloudflare",
    "cloudflare:login": "void cloudflare login",
    "cloudflare:status": "void cloudflare status"
  },
  "dependencies": {
    "@animate-ui/react": "2.0.0",
    "@base-ui/react": "1.9.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "0.27.20",
    "@lezer/highlight": "^1.2.5",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "codemirror": "^6.0.2",
    "express": "^5.1.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.60.0",
    "motion": "14.5.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.5.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "void": "1.1.12",
    "vue": "^3.5.44"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "license": "SEE LICENSE IN LICENSE.md"
}
