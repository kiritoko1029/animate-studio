# Animate Studio cloud accounts configuration
# Copy to .env (git-ignored) and fill in real values.

# --- Better Auth -------------------------------------------------------------
# 32+ char random string. REQUIRED in production; sessions are signed with it.
BETTER_AUTH_SECRET=
# Public origin of the deployment, e.g. https://studio.example.com
BETTER_AUTH_URL=http://127.0.0.1:4173
# Extra origins allowed to call auth endpoints (comma-separated), if the
# frontend is served from another origin.
STUDIO_TRUSTED_ORIGINS=

# --- Email OTP via Resend ----------------------------------------------------
# Create a sender at https://resend.com/domains and verify it.
# When either value is empty, email sign-in reports as disabled and the
# anonymous editor keeps working.
RESEND_API_KEY=
RESEND_FROM=Animate Studio <noreply@example.com>

# --- GitHub OAuth ------------------------------------------------------------
# OAuth App: https://github.com/settings/developers
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# --- Storage -----------------------------------------------------------------
# Leave unset for local SQLite (data/studio-accounts.sqlite, no credentials).
# Set to PostgreSQL to use the real adapter (same schema as Cloudflare):
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/animate_studio
DATABASE_URL=

# Keep the legacy shared /api/page endpoints in production (NOT recommended;
# every visitor shares one file). Omit or set 0 to block them.
STUDIO_ALLOW_LEGACY_PAGE_API=0
